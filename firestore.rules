rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper para verificar se o requisitante é admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/system/admins)
        && request.auth.uid in get(/databases/$(database)/documents/system/admins).data.uids;
    }

    // Helper para verificar se é o próprio dono do documento
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---------- Sistema / Admins ----------
    match /system/{docId} {
      // Qualquer usuário autenticado pode ler (necessário para checar role no cliente)
      allow read: if request.auth != null;

      // Bootstrap do primeiro admin.
      //
      // Sem isto o projeto é impossível de inicializar: `isAdmin()` depende do
      // documento system/admins existir, e nenhuma regra permitiria criá-lo.
      //
      // A condição fecha a porta: só dá para criar o documento se o PRÓPRIO
      // autor estiver na lista de uids. Ou seja, você só pode se promover a si
      // mesmo — não dá para transformar outra conta em admin por aqui. Depois
      // que o documento existe, qualquer alteração exige já ser admin.
      allow create: if request.auth != null
                    && request.resource.data.uids is list
                    && request.auth.uid in request.resource.data.uids;

      // Após criado, só admins mexem.
      allow update, delete: if isAdmin();
    }

    // ---------- Usuários ----------
    match /users/{uid} {
      // Dono pode ler seu próprio perfil. Admin pode ler qualquer perfil.
      allow get: if isOwner(uid) || isAdmin();
      // Lista de usuários: apenas admins
      allow list: if isAdmin();

      // Criação: o próprio usuário pode criar seu perfil no primeiro login
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'jogador';

      // Atualização: dono pode editar campos de perfil (exceto role/admin forçados).
      // Admin pode editar qualquer campo (inclusive promover/rebaixar).
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role)
                    || isAdmin();

      // Exclusão: apenas admins (protege último admin via lógica de app)
      allow delete: if isAdmin();
    }

    // ---------- Catálogo (leitura pública p/ cliente, escrita apenas Admin) ----------
    match /classes/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /skills/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /items/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /recipes/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /monsters/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /worldTemplates/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /achievements/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /estacoes/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /biomas/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /npcs/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /servidores/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /backups/{id} {
      // Backups são privados: apenas admins podem ler/escrever
      allow read, write: if isAdmin();
    }

    // ---------- Portais (públicos entre amigos) ----------
    match /portais/{uid} {
      // Qualquer jogador autenticado pode ver portais ativos/lista
      allow read: if request.auth != null;

      // Apenas o dono cria/atualiza/apaga seu próprio portal
      allow create, update, delete: if isOwner(uid)
                                    && request.resource.data.uid == uid;
    }

    // ---------- Progresso privado do jogador ----------
    match /jogadores/{uid} {
      // O dono controla o próprio progresso. O admin também — é o que permite
      // a aba "Personagens" mover, duplicar e remover heróis.
      //
      // Abertura consciente de superfície: o admin passa a ver inventário,
      // base e nível de qualquer conta. É necessário para moderar (travar
      // conta quebrada, corrigir progresso corrompido), e o painel já exibe
      // dados equivalentes em `users` e `portais`. O risco é de administer
      // ler dados que o jogador considers privados; se isso incomodar, o
      // caminho é restringir por campo, o que exige lógica no backend.
      allow get, create, update, delete: if isOwner(uid) || isAdmin();

      // Listar todos os jogadores é o que alimenta a tabela de personagens.
      // Sem isto, `repoUsuarios`-style de jogadores/{uid} fica impossível:
      // o painel não conseguiria nem montar a lista.
      allow list: if isAdmin();
    }

    // Subcoleções do jogador (futuro: inventario, blocos da base, etc.)
    match /jogadores/{uid}/{subcollection}/{docId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /bases/{uid} {
      // Base/worldstate privada do dono
      allow read, write: if isOwner(uid);
    }

    // Bloqueio padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}