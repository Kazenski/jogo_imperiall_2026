{
  "name": "jogo-imperiall-2026",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Jogo 2D medieval de construcao e sobrevivencia com Portais Arcanos entre as bases dos amigos",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node testes/logica.mjs",
    "test:painel": "node testes/painel.mjs",
    "test:chunks": "node testes/chunks.mjs",
    "test:terreno": "node testes/terreno.mjs",
    "test:integridade": "node testes/integridade.mjs",
    "test:storage": "firebase emulators:exec --only auth,firestore,storage --project demo-jogo \"node testes/storage-regras.mjs\"",
    "test:tudo": "npm run test && npm run test:painel && npm run test:chunks && npm run test:terreno && npm run test:integridade"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  }
}
